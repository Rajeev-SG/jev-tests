# Large raw downloads: regenerated by the build scripts, never committed.
data/adpi/dataset.json

__pycache__/
*.pyc

# Session-derived material stays local: it contains real work paths, client
# names and tool output. The extractor scripts are committed; the samples are
# not. Aggregate results (summary.json, CSVs) are committed.
data/sessions/*.jsonl
data/context/*.jsonl
data/prs/*.jsonl

# Third-party API responses. Cached so re-runs are free and reproducible;
# never committed.
results/.cache/
